model WhatsAppMessage {
  id               String   @id @default(cuid())
  messageId        String?  // WhatsApp message ID for editing
  groupId          String?  // Group ID where sent
  phoneNumber      String?  // Phone number if sent to user
  message          String   @db.Text
  originalMessage  String?  @db.Text // For tracking edits
