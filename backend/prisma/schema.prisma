generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  fullName          String
  email             String    @unique
  password          String
  phone             String    @unique
  phoneVerified     Boolean   @default(false)

   emailVerified     Boolean   @default(false)
  verificationCode  String?
  verificationExpiry DateTime?
  role              String    @default("member") // "member", "admin" (for chairman)
  profileImage      String?
  createdAt         DateTime  @default(now())
  lastActive        DateTime?
  jumuiaId          String?
  membership_number String?   @unique
  resetCode         String?
  resetCodeExpiry   DateTime?
  isOnline          Boolean   @default(false)
  lastSeen          DateTime?
  lastResetAttempt  DateTime?
  resetAttempts     Int       @default(0)

  // Special role fields for ZUCA CA structure
  specialRole      String? // "jumuia_leader", "choir_moderator", "secretary", "treasurer", or null
  assignedJumuiaId String? // Which jumuia they lead (only for jumuia_leaders)
  lastRoleLogin    DateTime? // Track last time they used special login


  // Relations
  blockedBy        BlockedUser[]     @relation("BlockedBy")
  blockedUsers     BlockedUser[]     @relation("UserBlocks")
  uploadedMedia    Media[]           @relation("UserMedia")
  mediaComments    MediaComment[]
  mediaDownloads   MediaDownload[]
  mediaLikes       MediaLike[]
  mediaShares      MediaShare[]
  mediaViews       MediaView[]
  mentions         Mention[]
  messages         Message[]         @relation("UserMessages")
  messageReactions MessageReaction[]
  Notification     Notification[]
  pinnedMessages   Pin[]
  pledges          Pledge[]
  pushSubscription PushSubscription?
  readReceipts     ReadReceipt[]

  // Relations
  pledgeMessages PledgeMessage[]

// Relations for Mass  readings
   massReadings MassReading[]

  // NEW: Relations for created content
  announcementsCreated Announcement[] @relation("UserAnnouncements")
  massProgramsCreated  MassProgram[]  @relation("UserMassPrograms")

// Relations for viewing announcements
  announcementViews AnnouncementView[]

  // Jumuia relations with unique names
  homeJumuia    Jumuia? @relation("UserHomeJumuia", fields: [jumuiaId], references: [id]) // Their home jumuia
  leadingJumuia Jumuia? @relation("UserLeadingJumuia", fields: [assignedJumuiaId], references: [id]) // Jumuia they lead (if leader)

  // NEW: Jumuia-specific chat relations
  jumuiaChatMessages  JumuiaChatMessage[]
  jumuiaChatReactions JumuiaChatReaction[]
  jumuiaMentions      JumuiaMention[]
  jumuiaReadReceipts  JumuiaReadReceipt[]

  executiveAssignments Executive[] // Positions this user holds
  executiveHistory     ExecutiveHistory[] // Historical positions this user held
  // Game relations
  sentGameInvites      GameInvite[]       @relation("SentInvites")
  receivedInvites      GameInvite[]       @relation("ReceivedInvites")
  gamesAsPlayer1       GameSession[]      @relation("Player1Games")
  gamesAsPlayer2       GameSession[]      @relation("Player2Games")

  //SCHEDULES RELATIONS
  schedules      Schedule[]
  scheduleDrafts ScheduleDraft[]

  files File[] // Files uploaded by this user

    payments             Payment[]   

    //prayer 
      prayerFavorites  UserFavorite[]
  prayerNotes      UserPrayerNote[]

  //fb
  feedback         Feedback[] 

    treasurerTransactions TreasurerTransaction[]

    //bank
    bankPayments BankPayment[]

    //emails

    emailWebhookLogs EmailWebhookLog[]


     // For Attendance System
  attendanceSheetsCreated AttendanceSheet[]  @relation("UserAttendanceSheets")
  attendanceEntries       AttendanceEntry[]  @relation("AttendanceUser")
  attendanceVerified      AttendanceEntry[]  @relation("AttendanceVerifier")
 attendanceLinksCreated  AttendanceLink[]    @relation("UserAttendanceLinks")
  // =====DIRECT MESSAGING ====================
  
  // Conversations (Direct Messages)
  conversations1 Conversation[] @relation("Participant1")
  conversations2 Conversation[] @relation("Participant2")
  
  // Direct Messages sent
  sentMessages   DirectMessage[] @relation("SentMessages")
  
  // DM Files
  dmFiles        DirectMessageFile[]
  
  // DM Reactions
  dmReactions    DirectMessageReaction[]
  
  // DM Read Receipts
  dmReadReceipts DirectMessageReadReceipt[]
  
  // DM Blocks (who I blocked)
  blockedByMe    BlockedDMUser[] @relation("DMBlocker")
  
  // DM Blocks (who blocked me)
  blockedMe      BlockedDMUser[] @relation("DMBlocked")
  
  // DM Reports I made
  dmReports      ReportedDMMessage[] @relation("DMReporter")


  
  // ==================== DM PHASE 2 & 3 RELATIONS ====================
  
  // Search
  dmSearchIndex      DMSearchIndex[]      // Messages I sent that are indexed
  
  // Typing
  dmTypingStatus     DMTypingStatus[]     // My typing status
  
  // Drafts
  dmDrafts           DMDraft[]            // My saved drafts
  
  // Scheduled
  dmScheduled        DMScheduled[]        // My scheduled messages
  
  // Pinned
  dmPinned           DMPinned[]           // Messages I pinned
  
  // Shares
  dmShares           DMShare[]            // Messages I shared
  
  // Broadcasts (admin)
  dmBroadcasts       DMBroadcast[]        // Broadcasts I sent
  dmBroadcastReceipts DMBroadcastReceipt[] // Broadcasts I received
  
  // Settings
  dmSettings         DMSettings?         

  // Meeting Minutes relations
minutesCreated   MeetingMinutes[] @relation("MinutesCreator")
minutesPublished MeetingMinutes[] @relation("MinutesPublisher")
actionItems      MeetingActionItem[]
minutesViewed    MeetingMinutesView[]
excuses          MeetingExcuse[]
minutesComments  MeetingComment[]

// ===== BIOMETRIC/FINGERPRINT FIELDS =====
  biometricRegistered    Boolean  @default(false)
  biometricCredentialId  String?  @unique
  biometricPublicKey     String?
  biometricTransports    String?  // JSON array of transports
  lastBiometricLogin     DateTime?
  biometricCredentials   String?

  biometricChallenges    BiometricChallenge[]


 @@index([email])
  @@index([membership_number])
  @@index([lastActive])
  @@index([jumuiaId])
  @@index([role])
  @@index([specialRole])
  @@index([createdAt])

}

  


model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  // Track who created it
  createdBy String?
  author    User?   @relation("UserAnnouncements", fields: [createdBy], references: [id])

  // Optional: which jumuia this announcement is for (null = all)
  jumuiaId String?
  jumuia   Jumuia? @relation(fields: [jumuiaId], references: [id])

   views     AnnouncementView[]
  

  

  @@index([createdAt])
  @@index([published])
}


model AnnouncementView {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  viewedAt       DateTime @default(now())
  
  // Relations
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Each user can only view each announcement once
  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@index([viewedAt])
}

model MassProgram {
  id        String   @id @default(uuid())
  date      DateTime
  venue     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Which jumuia this mass program is for
  jumuiaId String?
  jumuia   Jumuia? @relation(fields: [jumuiaId], references: [id])

  // Track who created it
  createdBy String?
  author    User?   @relation("UserMassPrograms", fields: [createdBy], references: [id])

  songs        MassProgramSong[]
  pendingSongs PendingSong[]
}

model Song {
  id        String  @id @default(uuid())
  title     String
  composer  String?
  lyrics    String? // Full song text with verses
  reference String? // e.g., "AGJ 451/134", "NAGJ 188/52"

  massPrograms MassProgramSong[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime? // Optional - won't break existing rows
}

model MassProgramSong {
  id            String      @id @default(uuid())
  massProgramId String
  songId        String
  type          String
  massProgram   MassProgram @relation(fields: [massProgramId], references: [id], onDelete: Cascade)
  song          Song        @relation(fields: [songId], references: [id])
}

model ContributionType {
  id             String    @id @default(uuid())
  title          String
  description    String?
  amountRequired Float      // Target amount
  collectedAmount Float     @default(0)  // ← ADD THIS - actual amount collected
  deadline       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  jumuiaId       String?
  jumuia         Jumuia?   @relation(fields: [jumuiaId], references: [id])
  pledges        Pledge[]
  paymentSlug    String?   @unique
  payments       Payment[]
  bankPayments BankPayment[]
}
model Pledge {
  id                 String           @id @default(uuid())
  userId             String
  contributionTypeId String
  pendingAmount      Float            @default(0)
  amountPaid         Float            @default(0)
  message            String?
  status             String           @default("PENDING")
  createdByAdmin     Boolean          @default(false)
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  contributionType   ContributionType @relation(fields: [contributionTypeId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pledgeMessages     PledgeMessage[]
    payments           Payment[]  

      @@index([userId])
  @@index([contributionTypeId])
  @@index([status])
  
   
}

model ChatRoom {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isActive       Boolean   @default(true)
  lastMessageAt  DateTime?
  messages       Message[]
  pinnedMessages Pin[]
}

model Message {
  id           String            @id @default(uuid())
  content      String
  userId       String
  roomId       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  replyToId    String?
  attachments  Json?
  files        File[]
  isEdited     Boolean           @default(false)
  isDeleted    Boolean           @default(false)
  deletedAt    DateTime?
  deletedBy    String?
  mentions     Mention[]
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]         @relation("MessageReplies")
  room         ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User              @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  pins         Pin[]
  readReceipts ReadReceipt[]

  @@index([userId])
  @@index([roomId])
  @@index([createdAt])
  @@index([replyToId])
  @@index([isDeleted])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  reaction  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId])
  @@index([userId])
}

model Mention {
  id        String    @id @default(uuid())
  messageId String
  userId    String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, isRead])
  @@index([messageId])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model Pin {
  id        String   @id @default(uuid())
  messageId String
  roomId    String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, messageId])
  @@index([roomId])
  @@index([messageId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  userId    String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
  @@index([userId])
  @@index([blockedId])
}

model Jumuia {
  id           String   @id @default(uuid())
  name         String   @unique // "ST. MICHAEL", "ST. BENEDICT", etc.
  code         String   @unique // "stmichael", "stbenedict", etc. (for login)
  whatsappLink String?  @map("whatsapp_link")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations with matching relation names
  members User[] @relation("UserHomeJumuia") // All members whose home is this jumuia
  leaders User[] @relation("UserLeadingJumuia") // Users who lead this jumuia

  contributions ContributionType[] // Contributions specific to this jumuia
  massPrograms  MassProgram[] // Mass programs for this jumuia's choir
  announcements Announcement[] // Announcements for this jumuia

  // NEW: Jumuia-specific chat and notifications
  chatRooms     JumuiaChatRoom[]
  notifications Notification[]

  broadcastTarget DMBroadcast[]

  meetingMinutes MeetingMinutes[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NEW: Jumuia-specific notification fields
  jumuiaId String?
  jumuia   Jumuia?   @relation(fields: [jumuiaId], references: [id])
  data     Json? // Store additional data like {contributionId, messageId, etc.}
  readAt   DateTime?
}

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String   @unique
  subscription String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id        String   @id @default(uuid())
  name      String
  type      String
  size      Int
  data      String   @db.Text // Base64 encoded file data
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([messageId])
  @@map("files")
}

model Media {
  id            String          @id @default(uuid())
  title         String
  description   String?
  filename      String
  originalName  String
  mimeType      String
  size          Int
  sizeFormatted String
  type          String
  url           String
  thumbnailUrl  String?
  category      String          @default("uncategorized")
  tags          String[]
  isPublic      Boolean         @default(true)
  isFeatured    Boolean         @default(false)
  uploadedById  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  uploadedBy    User            @relation("UserMedia", fields: [uploadedById], references: [id], onDelete: Cascade)
  comments      MediaComment[]
  downloads     MediaDownload[]
  likes         MediaLike[]
  shares        MediaShare[]
  views         MediaView[]

  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([uploadedById])
}

model MediaLike {
  id        String   @id @default(uuid())
  mediaId   String
  userId    String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@index([mediaId])
  @@index([userId])
  @@index([createdAt])
}

model MediaDownload {
  id           String   @id @default(uuid())
  mediaId      String
  userId       String
  downloadedAt DateTime @default(now())
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([userId])
  @@index([downloadedAt])
}

model MediaShare {
  id       String   @id @default(uuid())
  mediaId  String
  userId   String
  platform String   @default("direct")
  sharedAt DateTime @default(now())
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([userId])
  @@index([sharedAt])
}

model MediaView {
  id       String   @id @default(uuid())
  mediaId  String
  userId   String
  viewedAt DateTime @default(now())
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId, viewedAt])
  @@index([mediaId])
  @@index([userId])
  @@index([viewedAt])
}

model MediaComment {
  id        String   @id @default(uuid())
  content   String
  mediaId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([userId])
  @@index([createdAt])
}

model PledgeMessage {
  id        String   @id @default(uuid())
  pledgeId  String
  userId    String
  content   String   @db.Text
  isAdmin   Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  pledge Pledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@index([createdAt])
}

// ==================== NEW JUMUIA CHAT MODELS ====================

model JumuiaChatRoom {
  id            String    @id @default(uuid())
  name          String    @default("general")
  description   String?
  jumuiaId      String
  jumuia        Jumuia    @relation(fields: [jumuiaId], references: [id], onDelete: Cascade)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  messages JumuiaChatMessage[]

  @@unique([jumuiaId, name])
  @@index([jumuiaId])
  @@map("jumuia_chat_rooms")
}

model JumuiaChatMessage {
  id      String         @id @default(uuid())
  content String         @db.Text
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId  String
  room    JumuiaChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  attachments Json?

  replyToId String?
  replyTo   JumuiaChatMessage?  @relation("JumuiaMessageReplies", fields: [replyToId], references: [id])
  replies   JumuiaChatMessage[] @relation("JumuiaMessageReplies")

  isEdited  Boolean   @default(false)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replyCount    Int   @default(0)
  reactionCount Json?

  reactions    JumuiaChatReaction[]
  mentions     JumuiaMention[]
  readReceipts JumuiaReadReceipt[]

  @@index([roomId, createdAt])
  @@index([userId])
  @@index([replyToId])
  @@index([isDeleted])
  @@map("jumuia_chat_messages")
}

model JumuiaChatReaction {
  id        String            @id @default(uuid())
  messageId String
  message   JumuiaChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction  String
  createdAt DateTime          @default(now())

  @@unique([messageId, userId, reaction])
  @@index([messageId])
  @@index([userId])
  @@map("jumuia_chat_reactions")
}

model JumuiaMention {
  id        String            @id @default(uuid())
  messageId String
  message   JumuiaChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("jumuia_mentions")
}

model JumuiaReadReceipt {
  id        String            @id @default(uuid())
  messageId String
  message   JumuiaChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime          @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("jumuia_read_receipts")
}

model PendingSong {
  id        String   @id @default(uuid())
  title     String
  type      String?
  programId String?
  createdAt DateTime @default(now())
  status    String   @default("pending")

  program MassProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model LiturgicalDay {
  id                  Int      @id @default(autoincrement())
  date                DateTime @unique(map: "liturgical_day_date_unique") // Added map parameter
  season              String // advent, christmas, lent, easter, ordinary
  seasonName          String // "Advent", "Christmas Time", etc.
  celebration         String // "Sunday of the Word of God", etc.
  celebrationType     String // solemnity, feast, memorial, optional memorial, weekday
  liturgicalColor     String // green, white, purple, red, rose
  rank                String // "Solemnity", "Feast", "Memorial", etc.
  yearCycle           String? // A, B, or C for Sunday cycle
  weekdayCycle        String? // I or II for weekday cycle
  weekNumber          Int? // Week of the season
  holyDayOfObligation Boolean  @default(false)

  // Optional: Store readings
  readings Json? // Store as JSON array

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date], name: "liturgical_day_date_unique") // Added name parameter
  @@map("liturgical_days")
}

// ==================== EXECUTIVE MANAGEMENT SYSTEM ====================

model ExecutivePosition {
  id          String   @id @default(uuid())
  title       String   @unique
  level       Int // 1=Highest (Chairperson), 10=Lowest
  category    String // leadership, choir, jumuia, media, voice
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executives Executive[] // Current executives in this position
  history    ExecutiveHistory[] // Historical assignments for this position
}

model Executive {
  id         String   @id @default(uuid())
  userId     String
  positionId String
  assignedBy String // Admin ID who assigned
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)

  // Custom contact info (if different from user's default)
  customPhone String?
  customEmail String?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position ExecutivePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
  @@index([userId])
  @@index([positionId])
  @@index([isActive])
}

model ExecutiveHistory {
  id         String    @id @default(uuid())
  userId     String
  positionId String
  assignedBy String
  assignedAt DateTime
  removedAt  DateTime?
  removedBy  String?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position ExecutivePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([positionId])
  @@index([removedAt])
}

model GameSession {
  id          String   @id @default(uuid())
  gameType    String // 'tictactoe', 'snake', etc.
  player1Id   String
  player2Id   String?
  status      String   @default("waiting") // waiting, active, completed, cancelled
  currentTurn String? // player id whose turn it is
  gameState   Json? // board state, scores, etc.
  winner      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player1 User  @relation("Player1Games", fields: [player1Id], references: [id])
  player2 User? @relation("Player2Games", fields: [player2Id], references: [id])
}

model GameInvite {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  gameType   String
  sessionId  String?
  status     String   @default("pending") // pending, accepted, declined, cancelled
  createdAt  DateTime @default(now())

  fromUser User @relation("SentInvites", fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedInvites", fields: [toUserId], references: [id])
}

// ==================== SCHEDULE MANAGEMENT SYSTEM ====================

model Schedule {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  description String?   @db.Text
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  isPublished Boolean   @default(false) @map("is_published")
   isActiveSemester Boolean @default(false) @map("is_active_semester")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String    @map("created_by")

  //STRUCTURED DATA FIELDS
  sections        Json?   @map("sections")
  generalPoints   Json?   @map("general_points")
  additionalNotes String? @map("additional_notes") @db.Text
  semesterPeriod  Json?   @map("semester_period")

  creator     User                 @relation(fields: [createdBy], references: [id])
  events      ScheduleEvent[]
  attachments ScheduleAttachment[]

  // opposite relation for ScheduledNotification
  notificationSchedules ScheduledNotification[]

  @@map("Schedule")
}

model ScheduleEvent {
  id           String   @id @default(uuid())
  scheduleId   String   @map("schedule_id")
  title        String
  description  String?  @db.Text
  eventDate    DateTime @map("event_date")
  eventTime    String?  @map("event_time")
  location     String?
  groupName    String?  @map("group_name")
  reminderDays Int[]    @default([7, 1, 0]) @map("reminder_days")
  isNotified   Boolean  @default(false) @map("is_notified")
  createdAt    DateTime @default(now()) @map("created_at")

  schedule              Schedule                @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  ScheduledNotification ScheduledNotification[]

  @@map("ScheduleEvent")
}

model ScheduleAttachment {
  id         String   @id @default(uuid())
  scheduleId String   @map("schedule_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  fileSize   Int?     @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("ScheduleAttachment")
}

model ScheduleDraft {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  description String?  @db.Text
  formData    Json     @map("form_data")
  freeContent String?  @map("free_content") @db.Text
  activeTab   String   @default("structured") @map("active_tab")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("schedule_drafts")
}

// ==================== SCHEDULE NOTIFICATION SYSTEM ====================

model ScheduledNotification {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  scheduleId  String    @map("schedule_id")
  title       String
  message     String    @db.Text
  notifyAt    DateTime  @map("notify_at")
  priority    String    @default("normal") // normal, high, urgent, critical
  isSent      Boolean   @default(false) @map("is_sent")
  sentAt      DateTime? @map("sent_at")
  targetGroup String?   @map("target_group")
  createdAt   DateTime  @default(now()) @map("created_at")

  event    ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schedule Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([scheduleId])
  @@index([notifyAt])
  @@index([isSent])
  @@index([priority])
  @@map("scheduled_notifications")
}


model TreasurerNote {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String?  @db.Text
  images    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}


model Payment {
  id                 String       @id @default(uuid())
  amount             Float
  phoneNumber        String
  transactionId      String?      @unique
  checkoutRequestID  String?      @unique
  mpesaReceiptNumber String?      @unique
  status             PaymentStatus @default(PENDING)
  resultCode         Int?
  resultDesc         String?
  
  // Make pledge OPTIONAL
  pledgeId           String?
  pledge             Pledge?      @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  
  // Add contributionType relation
  contributionTypeId String?
  contributionType   ContributionType? @relation(fields: [contributionTypeId], references: [id], onDelete: SetNull)
  
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  completedAt        DateTime?
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}


// ==================== DIRECT MESSAGING SYSTEM ====================

// 1. Conversations table - stores chat sessions between two users
model Conversation {
  id             String   @id @default(uuid())
  participant1Id String
  participant2Id String
  participant1   User     @relation("Participant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User     @relation("Participant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  
  // Last message preview (for conversation list)
  lastMessage    String?  @db.Text
  lastMessageAt  DateTime @default(now())
  lastMessageBy  String?  // User ID who sent last message
  
  // Unread counts per participant
  unreadCount1   Int      @default(0)
  unreadCount2   Int      @default(0)
  
  // Metadata
  isArchived1    Boolean  @default(false)
  isArchived2    Boolean  @default(false)
  isDeleted1     Boolean  @default(false)
  isDeleted2     Boolean  @default(false)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  messages DirectMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id, participant2Id])
  @@index([participant1Id, lastMessageAt])
  @@index([participant2Id, lastMessageAt])
  @@map("conversations")

    // relations:
  searchIndex   DMSearchIndex[]    // Search index entries
  typingStatus  DMTypingStatus[]   // Who is typing
  drafts        DMDraft[]          // Drafts in this conversation
  scheduled     DMScheduled[]      // Scheduled messages
  pinned        DMPinned[]         // Pinned messages in this conversation

}

// 2. Direct Messages table - stores individual messages
model DirectMessage {
  id             String   @id @default(uuid())
  content        String?  @db.Text
  senderId       String
  conversationId String
  
  // Message status
  isRead         Boolean  @default(false)
  readAt         DateTime?
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  isEdited       Boolean  @default(false)
  editedAt       DateTime?
  
  // Reply feature
  replyToId      String?
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  sender         User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        DirectMessage?    @relation("MessageReply", fields: [replyToId], references: [id])
  replies        DirectMessage[]   @relation("MessageReply")
  files          DirectMessageFile[]
  reactions      DirectMessageReaction[]
  readReceipts   DirectMessageReadReceipt[]
  reports        ReportedDMMessage[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("direct_messages")

   // relations:
  searchIndex  DMSearchIndex?   // Search index entry for this message
  pinnedBy     DMPinned[]       // Who pinned this message
  sharedVia    DMShare[]        // Share links for this message
  draftReplies DMDraft[]        // Drafts that reply to this message

}

// 3. File attachments for direct messages
model DirectMessageFile {
  id          String   @id @default(uuid())
  name        String
  type        String
  size        Int
  data        String   @db.Text
  thumbnail   String?  @db.Text
  messageId   String
  userId      String
  createdAt   DateTime @default(now())
  duration    Int?
  width       Int?
  height      Int?

  message     DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@index([type])
  @@map("direct_message_files")
}

// 4. Reactions on direct messages
model DirectMessageReaction {
  id          String   @id @default(uuid())
  reaction    String
  messageId   String
  userId      String
  createdAt   DateTime @default(now())

  message     DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId])
  @@index([userId])
  @@map("direct_message_reactions")
}

// 5. Read receipts for direct messages
model DirectMessageReadReceipt {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  readAt      DateTime @default(now())

  message     DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("direct_message_read_receipts")
}

// 6. Blocked users for DM
model BlockedDMUser {
  id          String   @id @default(uuid())
  blockerId   String
  blockedId   String
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  blocker     User     @relation("DMBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("DMBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_dm_users")
}

// 7. Reported messages for moderation
model ReportedDMMessage {
  id          String   @id @default(uuid())
  messageId   String
  reporterId  String
  reason      String
  description String?  @db.Text
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  message     DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter    User          @relation("DMReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reporterId])
  @@index([status])
  @@map("reported_dm_messages")
}

// ==================== PHASE 2: ADDITIONAL DM TABLES ====================

// 1. Search index for fast message search
model DMSearchIndex {
  id             String   @id @default(uuid())
  messageId      String   @unique
  content        String   @db.Text
  conversationId String
  senderId       String
  createdAt      DateTime @default(now())

  message        DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([content])  // For full-text search
  @@index([conversationId])
  @@index([createdAt])
  @@map("dm_search_index")
}

// 2. Typing status tracking (for Socket.io)
model DMTypingStatus {
  conversationId String
  userId         String
  isTyping       Boolean  @default(false)
  updatedAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("dm_typing_status")
}

// 3. Draft messages (unsent)
model DMDraft {
  id             String   @id @default(uuid())
  userId         String
  conversationId String?
  content        String?  @db.Text
  files          Json?    // Store file metadata as JSON
  replyToId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  replyTo        DirectMessage? @relation(fields: [replyToId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([updatedAt])
  @@map("dm_drafts")
}

// 4. Scheduled messages
model DMScheduled {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  content        String?  @db.Text
  files          Json?    // Store file metadata as JSON
  scheduledFor   DateTime
  status         String   @default("pending") // pending, sent, cancelled, failed
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sentAt         DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([scheduledFor])
  @@index([status])
  @@map("dm_scheduled")
}

// 5. Pinned messages
model DMPinned {
  id             String   @id @default(uuid())
  messageId      String
  conversationId String
  userId         String
  pinnedAt       DateTime @default(now())

  message      DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])  // Can't pin same message twice
  @@index([conversationId])
  @@index([userId])
  @@index([pinnedAt])
  @@map("dm_pinned")
}

// 6. Shared message links (forwarding)
model DMShare {
  id             String   @id @default(uuid())
  messageId      String
  shareId        String   @unique  // Short code for sharing
  sharedBy       String
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  expiresAt      DateTime? // Optional expiry

  message      DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sharedByUser User          @relation(fields: [sharedBy], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@index([messageId])
  @@index([createdAt])
  @@map("dm_shares")
}


// ==================== PHASE 3: ADMIN & ANALYTICS TABLES ====================

// 7. Daily analytics for admin dashboard
model DMAnalytics {
  id                 String   @id @default(uuid())
  date               DateTime @unique
  totalMessages      Int      @default(0)
  totalConversations Int      @default(0)
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  filesShared        Int      @default(0)
  messagesDeleted    Int      @default(0)
  reportsFiled       Int      @default(0)
  blocksCreated      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
  @@map("dm_analytics")
}

// 8. Admin broadcast messages
model DMBroadcast {
  id             String   @id @default(uuid())
  senderId       String
  title          String
  content        String   @db.Text
  targetRole     String?  // null = all users, "admin", "member", etc.
  targetJumuiaId String?  // Send to specific jumuia only
  sentAt         DateTime @default(now())
  scheduledFor   DateTime? // Schedule for later
  status         String   @default("sent") // sent, scheduled, draft, cancelled

  sender User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  jumuia Jumuia? @relation(fields: [targetJumuiaId], references: [id], onDelete: SetNull)

  receipts DMBroadcastReceipt[]

  @@index([senderId])
  @@index([sentAt])
  @@index([status])
  @@map("dm_broadcasts")
}

// 9. Broadcast receipts (track who received/read)
model DMBroadcastReceipt {
  id          String   @id @default(uuid())
  broadcastId String
  userId      String
  read        Boolean  @default(false)
  readAt      DateTime?
  deliveredAt DateTime @default(now())

  broadcast DMBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@index([userId])
  @@index([read])
  @@map("dm_broadcast_receipts")
}

// 10. User messaging settings/preferences
model DMSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  notificationsEnabled  Boolean  @default(true)
  emailNotifications    Boolean  @default(false)
  pushNotifications     Boolean  @default(true)
  soundEnabled          Boolean  @default(true)
  theme                 String   @default("light")
  messageFontSize       String   @default("medium")
  enterToSend           Boolean  @default(true)
  showReadReceipts      Boolean  @default(true)
  showTypingIndicator   Boolean  @default(true)
  autoDeleteDays        Int?
  messagePreview        Boolean  @default(true)        
  blockedNotifications  Boolean  @default(false)       
  deliveryReports       Boolean  @default(true)       
  readReports           Boolean  @default(true)        
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dm_settings")
}

// ==================== ATTENDANCE SYSTEM ====================

model AttendanceSheet {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  eventTime   String?
  location    String?


    jumuiaId    String?
    isExecutiveOnly Boolean @default(false)
  
  // Check-in settings
  allowSelfCheckin  Boolean @default(false)
  enableWifiCheckin Boolean @default(false)
  wifiSSID          String?
  checkinCode       String?
  
  // Status
  isActive    Boolean @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  closedAt    DateTime?

   enableWhatsAppAutoSend    Boolean   @default(false)
  whatsAppGroupIds          String?
  whatsAppGroupNames        String?
  whatsAppCustomMessage     String?
  whatsAppSendOnCheckin     Boolean   @default(true)
  whatsAppSendOnClose       Boolean   @default(true)
  whatsAppLastSentCount     Int       @default(0)
  
  entries     AttendanceEntry[]
  qrCodes     QRCodeToken[]  
  creator     User     @relation("UserAttendanceSheets", fields: [createdBy], references: [id], onDelete: Cascade)
  attendanceLinks AttendanceLink[]

  @@index([createdBy])
  @@index([eventDate])
  @@index([isActive])
  @@map("attendance_sheets")

  meetingMinutes MeetingMinutes[]
}
  
 

model AttendanceEntry {
  id            String   @id @default(uuid())
  sheetId       String
  userId        String?
  deviceId      String?
  deviceName    String?
  
  // Person details (filled from account or admin input)
  fullName      String
  phoneNumber   String?
  role          String?
   specialRole   String? 
  membershipNumber String?
  jumuiaId      String?
  jumuiaName    String?
  
  // Check-in tracking
  signMethod    SignMethod
  signTime      DateTime @default(now())
  verifiedBy    String?
  notes         String?
  
  // Wi-Fi tracking (if applicable)
  connectedSSID String?
  connectedBSSID String?
  
  // Relations
  sheet         AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user          User?           @relation("AttendanceUser", fields: [userId], references: [id], onDelete: SetNull)
  verifier      User?           @relation("AttendanceVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@unique([sheetId, userId])
  @@unique([sheetId, deviceId])
  @@index([sheetId])
  @@index([userId])
  @@index([signMethod])
  @@index([signTime])
  @@map("attendance_entries")
}

enum SignMethod {
  MANUAL
  SELF
  WIFI_AUTO
    QR_CODE
}

model QRCodeToken {
  id         String   @id @default(cuid())
  token      String   @unique
  sheetId    String
  sheet      AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  used       Boolean  @default(false)
  usedBy     String?
  usedCount  Int      @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  
  @@index([token])
  @@index([sheetId])
  @@index([expiresAt])
}

model AttendanceLink {
  id          String   @id @default(cuid())
  token       String   @unique
  sheetId     String
  sheet       AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  maxUses     Int?
  usedCount   Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  
  // Relations
  creator     User     @relation("UserAttendanceLinks", fields: [createdBy], references: [id])
  
  @@index([token])
  @@index([sheetId])
  @@index([expiresAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Prayer {
  id         String   @id @default(uuid())
  title      String
  category   String 
  subcategory String?
  prayer     String   @db.Text
  language   String   @default("en")
  version    String   @default("default")  // "default", "simplified", "children", etc.
  order      Int      @default(0)
  isActive   Boolean  @default(true)
    source     String?
    favoriteCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  favorites  UserFavorite[]
  notes      UserPrayerNote[]
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  prayerId  String
  createdAt DateTime @default(now())
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayer Prayer @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  
  @@unique([userId, prayerId])
}

model UserPrayerNote {
  id        String   @id @default(uuid())
  userId    String
  prayerId  String
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayer Prayer @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  
  @@unique([userId, prayerId])
}

// ==================== MEETING MINUTES SYSTEM ====================

enum MeetingType {
  EXECUTIVE
  JUMUIA
}

enum MinuteStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MeetingMinutes {
  id                String      @id @default(uuid())
  title             String
  meetingDate       DateTime
  meetingTime       String?
  venue             String?
  type              MeetingType @default(EXECUTIVE)
  jumuiaId          String?
  attendanceSheetId String
  presentMembers    Json
  presentGuests     Json
  absentMembers     Json
  agenda            Json?
  preliminaries     String?
  sections          Json?
  aob               Json?
  adjournment       String?
  actionItems       Json?
  chairpersonSigned Boolean     @default(false)
  chairpersonSignDate DateTime?
  secretarySigned   Boolean     @default(false)
  secretarySignDate DateTime?
  status            MinuteStatus @default(DRAFT)
  publishedAt       DateTime?
  publishedBy       String?
  createdBy         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  jumuia            Jumuia?     @relation(fields: [jumuiaId], references: [id])
  attendanceSheet   AttendanceSheet @relation(fields: [attendanceSheetId], references: [id])
  creator           User        @relation("MinutesCreator", fields: [createdBy], references: [id])
  publisher         User?       @relation("MinutesPublisher", fields: [publishedBy], references: [id])
  assignedActions   MeetingActionItem[]
  views             MeetingMinutesView[]
   excuses          MeetingExcuse[]
  comments         MeetingComment[]

  @@index([type])
  @@index([jumuiaId])
  @@index([attendanceSheetId])
  @@index([status])
  @@index([meetingDate])
  @@index([createdBy])
  @@map("meeting_minutes")

 
}

model MeetingActionItem {
  id                String       @id @default(uuid())
  minutesId         String
  task              String       @db.Text
  assignedToUserId  String
  assignedToName    String
  dueDate           DateTime?
  status            ActionStatus @default(PENDING)
  completedAt       DateTime?
  completedNotes    String?      @db.Text
  notifiedAt        DateTime?

  minutes           MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  assignedTo        User           @relation(fields: [assignedToUserId], references: [id])

  @@index([minutesId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([dueDate])
  @@map("meeting_action_items")
}

model MeetingMinutesView {
  id                String   @id @default(uuid())
  minutesId         String
  userId            String
  viewedAt          DateTime @default(now())

  minutes           MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id])

  @@unique([minutesId, userId])
  @@index([minutesId])
  @@index([userId])
  @@map("meeting_minutes_views")
}

model MeetingExcuse {
  id                String   @id @default(uuid())
  minutesId         String
  userId            String
  reason            String?  @db.Text
  excused           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  minutes           MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id])

  @@unique([minutesId, userId])
  @@index([minutesId])
  @@index([userId])
  @@map("meeting_excuses")
}

model MeetingComment {
  id                String   @id @default(uuid())
  minutesId         String
  userId            String
  comment           String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  minutes           MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id])

  @@index([minutesId])
  @@index([userId])
  @@index([createdAt])
  @@map("meeting_comments")
}

// Treasurer Ledger - Money IN/OUT tracking for treasurer reports
model TreasurerTransaction {
  id          String   @id @default(uuid())
  date        DateTime
  description String
  category    String
  type        String   // "IN" or "OUT"
  amount      Float
  reference   String?
  notes       String?  @db.Text
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([type])
  @@index([category])
  @@index([createdBy])
  @@map("treasurer_transactions")
}

// Add this AFTER the TreasurerTransaction model
model TreasurerAuditLog {
  id              String   @id @default(uuid())
  transactionId   String   // The transaction that was changed
  action          String   // "CREATE", "UPDATE", "DELETE"
  
  // Store BEFORE and AFTER snapshots
  oldData         Json?    // Complete transaction data before change
  newData         Json?    // Complete transaction data after change
  
  // Track exactly what changed (for UPDATE actions)
  changedFields   Json?    // Example: [{"field":"amount","old":50000,"new":55000}]
  
  // Who did it
  performedBy     String   // User ID
  performedByName String   // User name for display
  
  // Where from
  ipAddress       String?
  userAgent       String?
  
  // When
  timestamp       DateTime @default(now())
  
  @@index([transactionId])
  @@index([performedBy])
  @@index([action])
  @@index([timestamp])
  @@map("treasurer_audit_logs")
}

model History {
