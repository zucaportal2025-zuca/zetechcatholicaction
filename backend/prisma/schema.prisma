model MassReading {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime
  dateLabel   String    @map("date_label")
  isPublished Boolean   @default(true) @map("is_published")
  uploadedBy  String    @map("uploaded_by")
